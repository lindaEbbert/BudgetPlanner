Content-Type: application/json
Authorization: Bearer {{token}}

{
  "name": "Miete",
  "description": "Kaltmiete + Nebenkosten",
  "categoryId": "{{catWohnen}}",
  "amount": 950.00,
  "intervalUnit": "MONTH",
  "intervalValue": 1,
  "startDate": "2025-12-01"
}

