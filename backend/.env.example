# Copy to .env and fill in your values.

DB_USER=your_user
DB_PASSWORD=your_password
DB_HOST=localhost
DB_PORT=5432
DB_NAME=budget_planner_db

JWT_SECRET_KEY=your_secret_key

# Category suggestions: any OpenAI-compatible chat completions endpoint.
# Without LLM_BASE_URL and LLM_MODEL the suggestion endpoint returns no suggestion.

# Default: local model via LM Studio (Developer tab -> start server).
# LLM_MODEL is the model ID LM Studio shows for the loaded model (also listed at GET /v1/models).
LLM_BASE_URL=http://localhost:1234/v1
LLM_MODEL=your_lm_studio_model_id
# LLM_API_KEY is not needed for LM Studio.
# Optional, defaults to 10. A local model on the CPU may need more.
# LLM_TIMEOUT_SECONDS=10

# Alternative: an external provider (sends transaction text to that provider).
# LLM_BASE_URL=https://api.example.com/v1
# LLM_MODEL=provider_model_id
# LLM_API_KEY=your_provider_api_key
