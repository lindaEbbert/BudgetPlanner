# Copy to .env and fill in your values.

DB_USER=your_user
DB_PASSWORD=your_password
DB_HOST=localhost
DB_PORT=5432
DB_NAME=budget_planner_db

JWT_SECRET_KEY=your_secret_key

# Frontend origins allowed to call the API, comma-separated. Defaults to http://localhost:4200.
# In production set it to the frontend URL, e.g. https://your-project.vercel.app
# CORS_ORIGINS=http://localhost:4200

# Category suggestions: any OpenAI-compatible chat completions endpoint.
# Pick ONE of the options below and uncomment its lines.
# Without LLM_BASE_URL and LLM_MODEL the suggestion endpoint returns no suggestion
# and nothing is sent anywhere. See backend/README.md -> "Category Suggestions: Choosing an LLM".

# Option A: local model via LM Studio (Developer tab -> start server).
# LLM_MODEL is the model ID LM Studio shows for the loaded model (also listed at GET /v1/models).
# No API key needed; transaction text stays on this machine.
# LLM_BASE_URL=http://localhost:1234/v1
# LLM_MODEL=gemma-4-e4b-it-qat

# Option B: OpenAI (sends transaction text to OpenAI).
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_MODEL=gpt-4.1-mini
# LLM_API_KEY=your_openai_api_key

# Option C: Z.AI (sends transaction text to Z.AI).
# LLM_BASE_URL=https://api.z.ai/api/paas/v4/
# LLM_MODEL=glm-4.7-flash
# LLM_API_KEY=your_z_ai_api_key

# Optional for every option, defaults to 10. A local model on the CPU may need more.
# LLM_TIMEOUT_SECONDS=10
