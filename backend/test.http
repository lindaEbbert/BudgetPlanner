> {%
  client.global.set("token", response.body.access_token);
%}

### ─────────────────────────────────────
### CATEGORIES
### ─────────────────────────────────────

### GET Categories
GET http://localhost:5000/categories
Authorization: Bearer {{token}}

### POST Category - Einnahme
POST http://localhost:5000/categories
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "name": "Tanzstunden"
}

> {%
  client.global.set("categoryIncomeId", response.body.id);
%}

### POST Category - Ausgabe
POST http://localhost:5000/categories
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "name": "Strom"
}

> {%
  client.global.set("categoryExpenseId", response.body.id);
%}

### PUT Category - umbenennen
PUT http://localhost:5000/categories/{{categoryIncomeId}}
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "name": "Tanzstunden aktualisiert"
}

### DELETE Category
DELETE http://localhost:5000/categories/{{categoryIncomeId}}
Authorization: Bearer {{token}}

### POST Category - Name einer gelöschten Category (409 mit deletedCategory)
POST http://localhost:5000/categories
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "name": "Tanzstunden aktualisiert"
}

### POST Category - trotzdem neu anlegen (die gelöschte bleibt gelöscht)
POST http://localhost:5000/categories
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "name": "Tanzstunden aktualisiert",
  "ignoreDeletedCategory": true
}

> {%
  client.global.set("categoryRecreatedId", response.body.id);
%}

### DELETE Category - die neu angelegte wieder löschen, damit Wiederherstellen geht
DELETE http://localhost:5000/categories/{{categoryRecreatedId}}
Authorization: Bearer {{token}}

### POST Category wiederherstellen (alte ID kommt zurück)
POST http://localhost:5000/categories/{{categoryIncomeId}}/restore
Authorization: Bearer {{token}}

### ─────────────────────────────────────
### TRANSACTIONS
### ─────────────────────────────────────

### GET Balance (leer)
GET http://localhost:5000/transactions/balance
Authorization: Bearer {{token}}

### GET Transactions (leer)
GET http://localhost:5000/transactions
Authorization: Bearer {{token}}

### POST Transaction - Anfangssaldo (INITIAL)
POST http://localhost:5000/transactions
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "name": "Anfangssaldo",
  "amount": 1000.00,
  "type": "INITIAL",
  "categoryId": "{{categoryIncomeId}}",
  "transactionDate": "2026-01-01",
  "description": "Startsaldo Konto"
}

> {%
  client.global.set("initialTransactionId", response.body.id);
%}

### POST Transaction - Einnahme
POST http://localhost:5000/transactions
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "name": "Januargehalt",
  "amount": 2500.00,
  "type": "INCOME",
  "categoryId": "{{categoryIncomeId}}",
  "transactionDate": "2026-05-01"
}

> {%
  client.global.set("transactionId", response.body.id);
%}

### POST Transaction - Ausgabe
POST http://localhost:5000/transactions
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "name": "Januarstrom",
  "amount": 800.00,
  "type": "EXPENSE",
  "categoryId": "{{categoryExpenseId}}",
  "transactionDate": "2026-05-01",
  "description": "Strom Mai"
}

### GET Balance (sollte initial:1000 + income:2500 - expense:800 = 2700 sein)
GET http://localhost:5000/transactions/balance
Authorization: Bearer {{token}}

### GET Transactions (alle drei sichtbar)
GET http://localhost:5000/transactions
Authorization: Bearer {{token}}

### PUT Transaction - Betrag ändern
PUT http://localhost:5000/transactions/{{transactionId}}
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "name": "Januargehalt korrigiert",
  "amount": 2600.00,
  "transactionDate": "2026-05-01"
}

### GET Balance nach Update (sollte 2800 sein)
GET http://localhost:5000/transactions/balance
Authorization: Bearer {{token}}

### VOID Transaction - Einnahme stornieren
POST http://localhost:5000/transactions/{{transactionId}}/void
Content-Type: application/json
Authorization: Bearer {{token}}

{}

### GET Balance nach Void (sollte wieder 200 sein: initial:1000 - expense:800)
GET http://localhost:5000/transactions/balance
Authorization: Bearer {{token}}

### GET Transactions (ohne stornierte — stornierte Einnahme unsichtbar)
GET http://localhost:5000/transactions
Authorization: Bearer {{token}}

### GET Transactions mit stornierten (alle sichtbar)
GET http://localhost:5000/transactions?include_voided=true
Authorization: Bearer {{token}}

### POST Category Suggestion (needs LLM_BASE_URL and LLM_MODEL in .env; without them categoryId and newCategoryName are null)
POST http://localhost:5000/transactions/category-suggestion
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "name": "Rewe",
  "description": "Wocheneinkauf",
  "type": "EXPENSE"
}

